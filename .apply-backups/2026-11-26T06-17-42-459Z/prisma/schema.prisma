// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (مقادیر استاندارد سیستمی)
// ==========================================
enum PlanTier {
  FREE   // پلن رایگان
  OFFICE // پلن مطب
  CLINIC // پلن کلینیک
}

enum AddonModuleType {
  SMS_PACKAGE        // بسته شارژ پنل پیامک
  COMMISSION_PERCASE // ماژول کمیسیون و پرکیس
  AI_ASSISTANT       // ماژول دستیار هوش مصنوعی
  VOICE_DATA_ENTRY   // ماژول ورود صوتی اطلاعات
  DATA_EXPORT        // ماژول خروجی اکسل و JSON
}

enum TicketStatus {
  OPEN
  PENDING_ADMIN
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ClinicSpaceType {
  ROOM       // اتاق کلینیک
  MULTI_UNIT // فضای چندیونیتی / چندتخته
  HOSPITAL   // بیمارستان / اتاق عمل / آنکال
}

enum ServiceTimingMode {
  SINGLE_STAGE // تک‌مرحله‌ای عادی
  SPLIT_STAGE  // چندمرحله‌ای با تایم آزاد میانی (مثل PRP: مرحله ۱ + تایم آزاد دستگاه/آماده‌سازی + مرحله ۲)
}

enum StaffScheduleStatus {
  IN_CLINIC      // حضور عادی در کلینیک / مطب برای نوبت‌دهی
  ON_CALL        // آنکال بیمارستان (امکان حضور مشروط در مطب تا زمان فراخوان)
  RESIDENT       // مقیم بیمارستان/مرکز (الزام حضور در مکان مشخص)
  HOSPITAL_SHIFT // شیفت بیمارستان (بسته بودن نوبت‌دهی مطب در این بازه)
  DAY_OFF        // مرخصی / عدم حضور
}

enum AppointmentBookingSource {
  MANUAL // رزرو دستی توسط پذیرش / پرسنل کلینیک
  AUTO   // رزرو اتوماتیک / دستیار هوشمند / نوبت‌دهی خودکار
}

enum AppointmentStatus {
  PENDING     // در انتظار تایید
  CONFIRMED   // تایید شده
  IN_PROGRESS // در حال انجام
  COMPLETED   // انجام شده
  CANCELED    // لغو شده
  NO_SHOW     // عدم حضور مراجع
}

enum AccountingEntryType {
  PAYOUT // پرداختی به ذی‌نفع
  DEBT   // بدهی به ذی‌نفع
}

// ==========================================
// 1. هویت، احراز هویت و دسترسی‌های سراسری
// ==========================================
model User {
  id         String   @id @default(uuid())
  phone      String   @unique
  fullName   String?
  password   String?
  nationalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions       Session[]
  systemAdmins   SystemAdmin[]
  clinicUsers    ClinicUser[]
  clientProfiles Client[]
  ticketMessages TicketMessage[]
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemAdmin {
  id     String @id @default(uuid())
  userId String
  level  String @default("SUPER_ADMIN")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. ساختار کلینیک، اشتراک و پرسنل (Multi-tenant)
// ==========================================
model Clinic {
  id        String @id @default(uuid())
  name      String
  subdomain String @unique

  // اطلاعات تکمیلی و هویتی مرکز
  logoUrl            String?
  province           String?
  city               String?
  address            String? @db.Text
  postalCode         String?
  landlinePhone      String?
  secondaryPhone     String?
  ownerNationalId    String?
  medicalCouncilCode String?
  website            String?
  instagram          String?

  currentPlan   PlanTier  @default(FREE)
  planExpiresAt DateTime?
  smsBalance    Int       @default(50)
  vatPercent    Float     @default(0)

  createdAt DateTime @default(now())

  roles               ClinicRole[]
  users               ClinicUser[]
  clients             Client[]
  services            Service[]
  spaces              ClinicSpace[]
  staffSchedules      ClinicStaffSchedule[]
  staffServiceTimings ClinicStaffServiceTiming[]
  appointments        Appointment[]
  products            ClinicProduct[]
  stockOuts           InventoryStockOut[]
  bankAccounts        ClinicBankAccount[]
  terminals           PaymentTerminal[]
  creditProviders     ClinicCreditProvider[]
  invoices            Invoice[]
  beneficiaries       AccountingBeneficiary[]
  descriptionItems    AccountingDescriptionItem[]
  ledgerEntries       AccountingLedgerEntry[]
  exportLogs          DataExportLog[]
  workingDays         ClinicWorkingDay[]

  smsSetting       ClinicSmsSetting?
  careSmsTemplates CareSmsTemplate[]
  bulkSmsCampaigns BulkSmsCampaign[]
  smsLogs          SmsLog[]

  subscriptions   ClinicSubscription[]
  purchasedAddons ClinicPurchasedAddon[]
  supportTickets  SupportTicket[]
  b2bOrders       B2BOrder[]
}

model ClinicWorkingDay {
  id              String   @id @default(uuid())
  clinicId        String
  date            DateTime
  isClinicHoliday Boolean  @default(false)
  holidayNote     String?
  shifts          Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, date])
}

model ClinicSpace {
  id              String          @id @default(uuid())
  clinicId        String
  name            String
  spaceType       ClinicSpaceType @default(ROOM)
  capacity        Int             @default(1)
  allowOverlap    Boolean         @default(false)
  requiresPrivacy Boolean         @default(false)
  equipmentNotes  String?         @db.Text
  description     String?         @db.Text
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  clinic          Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  allowedServices Service[]             @relation("SpaceAllowedServices")
  staffSchedules  ClinicStaffSchedule[]
  appointments    Appointment[]

  @@index([clinicId, spaceType, isActive])
  @@index([clinicId, sortOrder])
}

model ClinicStaffSchedule {
  id               String              @id @default(uuid())
  clinicId         String
  clinicUserId     String
  spaceId          String?
  weekday          Int?                // ۰=شنبه تا ۶=جمعه (برای برنامه هفتگی تکرارشونده)
  specificDate     DateTime?           // برای تاریخ/استثنای خاص
  startTime        String              // فرمت HH:mm مثل "09:00"
  endTime          String              // فرمت HH:mm مثل "17:00"
  status           StaffScheduleStatus @default(IN_CLINIC)
  blocksClinicBook Boolean             @default(false) // مثلاً true وقتی در شیفت بیمارستان است و نوبت مطب بسته می‌شود
  note             String?             @db.Text
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  clinic          Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicUser      ClinicUser   @relation(fields: [clinicUserId], references: [id], onDelete: Cascade)
  space           ClinicSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  allowedServices Service[]    @relation("ScheduleAllowedServices")

  @@index([clinicId, clinicUserId, weekday])
  @@index([clinicId, clinicUserId, specificDate])
  @@index([clinicId, spaceId])
}

model ClinicStaffServiceTiming {
  id                String            @id @default(uuid())
  clinicId          String
  clinicUserId      String
  serviceId         String
  timingMode        ServiceTimingMode @default(SINGLE_STAGE)
  prepBeforeMinutes Int               @default(0)
  durationMinutes   Int               @default(30)
  stage1Minutes     Int               @default(15)
  freeGapMinutes    Int               @default(0)
  stage2Minutes     Int               @default(15)
  restAfterMinutes  Int               @default(0)
  requiresPrivacy   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicUser ClinicUser @relation(fields: [clinicUserId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([clinicUserId, serviceId])
  @@index([clinicId, serviceId])
}

model ClinicRole {
  id          String   @id @default(uuid())
  clinicId    String
  name        String
  permissions String[]

  clinic Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  users  ClinicUser[]
}

model ClinicUser {
  id       String  @id @default(uuid())
  userId   String
  clinicId String
  roleId   String?

  jobTitle      String  @default("پرسنل")
  personnelCode String?
  specialty     String?
  avatarUrl     String?
  stampUrl      String?

  isOwner   Boolean   @default(false)
  isActive  Boolean   @default(true)
  canLogin  Boolean   @default(true)
  leftAt    DateTime?
  deletedAt DateTime?

  canBeTherapist Boolean @default(false)
  canBeAssistant Boolean @default(false)
  canBeReferrer  Boolean @default(false)

  hasAllServicesAccess Boolean  @default(true)
  permissions          String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role   ClinicRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  assignedServices    Service[]                  @relation("ServiceStaff")
  staffSchedules      ClinicStaffSchedule[]
  staffServiceTimings ClinicStaffServiceTiming[]
  staffAppointments   Appointment[]              @relation("AppointmentTherapist")
  createdAppointments Appointment[]              @relation("AppointmentCreator")
  providedServices    ProvidedService[]          @relation("ServiceTherapist")
  assistedServices    ProvidedService[]          @relation("ServiceAssistants")
  referredServices    ProvidedService[]          @relation("ServiceReferrer")
  referredClients     Client[]                   @relation("StaffClientReferrer")
  ledgerEntries       AccountingLedgerEntry[]
  exclusiveBatches    ProductBatch[]
  stockOuts           InventoryStockOut[]
  exportLogs          DataExportLog[]
  createdTickets      SupportTicket[]

  @@unique([userId, clinicId])
  @@index([clinicId, deletedAt])
}

model Client {
  id            String   @id @default(uuid())
  userId        String
  clinicId      String
  fileNumber    Int?
  nickname      String?
  walletBalance Int      @default(0)

  gender         String?
  birthDate      DateTime?
  referralSource String?
  tag            String?
  notes          String?   @db.Text

  referrerClientId String?
  referrerStaffId  String?

  additionalInfo Json @default("{}")
  medicalRecord  Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic          Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  referrerClient  Client?     @relation("ClientToClientReferral", fields: [referrerClientId], references: [id], onDelete: SetNull)
  referredClients Client[]    @relation("ClientToClientReferral")
  referrerStaff   ClinicUser? @relation("StaffClientReferrer", fields: [referrerStaffId], references: [id], onDelete: SetNull)

  appointments       Appointment[]
  providedServices   ProvidedService[]
  referredServices   ProvidedService[]       @relation("ServiceClientReferrer")
  invoices           Invoice[]
  ledgerEntries      AccountingLedgerEntry[]
  smsLogs            SmsLog[]
  attachments        ClientAttachment[]
  walletTransactions WalletTransaction[]

  @@unique([userId, clinicId])
  @@index([clinicId, fileNumber])
}

model ClientAttachment {
  id           String   @id @default(uuid())
  clientId     String
  title        String
  fileUrl      String
  fileType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model WalletTransaction {
  id            String   @id @default(uuid())
  clientId      String
  type          String
  amount        Int
  paymentMethod String?
  terminalId    String?
  description   String?  @db.Text
  createdById   String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// ==========================================
// 3. پلن‌های اشتراک و ماژول‌های قابل خرید (SaaS Billing)
// ==========================================
model SubscriptionPlan {
  id            String   @id @default(uuid())
  tier          PlanTier @unique
  title         String
  monthlyPrice  Int
  yearlyPrice   Int
  maxStaff      Int
  canExportData Boolean  @default(false)
  features      Json     @default("[]")

  subscriptions ClinicSubscription[]
}

model ClinicSubscription {
  id         String   @id @default(uuid())
  clinicId   String
  planId     String
  startDate  DateTime @default(now())
  endDate    DateTime
  paidAmount Int
  paymentRef String?
  status     String

  clinic Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model PlatformAddon {
  id           String          @id @default(uuid())
  code         AddonModuleType
  title        String
  price        Int
  smsCount     Int?
  durationDays Int?
  description  String?         @db.Text

  purchases ClinicPurchasedAddon[]
}

model ClinicPurchasedAddon {
  id          String    @id @default(uuid())
  clinicId    String
  addonId     String
  purchasedAt DateTime  @default(now())
  expiresAt   DateTime?
  paidAmount  Int
  isActive    Boolean   @default(true)

  clinic Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  addon  PlatformAddon @relation(fields: [addonId], references: [id])
}

model DataExportLog {
  id           String   @id @default(uuid())
  clinicId     String
  clinicUserId String?
  entityType   String
  format       String
  recordCount  Int      @default(0)
  createdAt    DateTime @default(now())

  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicUser ClinicUser? @relation(fields: [clinicUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
}

// ==========================================
// 4. فروشگاه مرکزی تامین کالا (B2B Supply Store)
// ==========================================
model PlatformProductCategory {
  id    String @id @default(uuid())
  title String
  slug  String @unique

  products PlatformProduct[]
}

model PlatformProduct {
  id          String  @id @default(uuid())
  categoryId  String
  name        String
  sku         String  @unique
  brand       String?
  unit        String
  price       Int
  stock       Int     @default(100)
  description String? @db.Text

  category   PlatformProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems B2BOrderItem[]
}

model B2BOrder {
  id           String   @id @default(uuid())
  clinicId     String
  totalAmount  Int
  status       String
  trackingCode String?
  createdAt    DateTime @default(now())

  clinic Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  items  B2BOrderItem[]
}

model B2BOrderItem {
  id                String @id @default(uuid())
  orderId           String
  platformProductId String
  quantity          Int
  unitPrice         Int

  order           B2BOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  platformProduct PlatformProduct @relation(fields: [platformProductId], references: [id])
}

// ==========================================
// 5. سیستم تیکت و پشتیبانی
// ==========================================
model SupportTicket {
  id                  String         @id @default(uuid())
  clinicId            String
  creatorClinicUserId String?
  creatorNameSnapshot String?
  subject             String
  department          String
  priority            TicketPriority @default(MEDIUM)
  status              TicketStatus   @default(OPEN)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  clinic   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  creator  ClinicUser?     @relation(fields: [creatorClinicUserId], references: [id], onDelete: SetNull)
  messages TicketMessage[]
}

model TicketMessage {
  id            String   @id @default(uuid())
  ticketId      String
  senderUserId  String?
  isFromAdmin   Boolean  @default(false)
  body          String   @db.Text
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
}

// ==========================================
// 6. کاتالوگ خدمات کلینیک (ساختار دو سطحی + زمان‌بندی سرویس و تایم آزاد میانی + مالیات)
// ==========================================
model Service {
  id         String  @id @default(uuid())
  clinicId   String
  title      String
  taxEnabled Boolean @default(false)

  // زمان‌بندی پیش‌فرض سرویس (تک‌مرحله‌ای یا چندمرحله‌ای با تایم آزاد میانی مثل PRP)
  timingMode        ServiceTimingMode @default(SINGLE_STAGE)
  prepBeforeMinutes Int               @default(0)  // زمان حضور مراجع قبل از شروع کار (مثلاً بی‌حسی)
  durationMinutes   Int               @default(30) // مدت انجام در حالت تک‌مرحله‌ای
  stage1Minutes     Int               @default(15) // مرحله اول (مثلاً خون‌گیری در PRP)
  freeGapMinutes    Int               @default(0)  // تایم آزاد میانی (مثلاً قرارگیری در دستگاه سانتریفیوژ؛ امکان رزرو مراجع دیگر)
  stage2Minutes     Int               @default(15) // مرحله دوم (مثلاً تزریق نهایی در PRP)
  restAfterMinutes  Int               @default(0)  // زمان استراحت/پاکسازی بعد از سرویس
  requiresPrivacy   Boolean           @default(false)

  clinic                 Clinic                          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  subServices            SubService[]
  defaultServiceProducts ServiceCategoryDefaultProduct[]
  careSmsTemplates       CareSmsTemplate[]
  assignedStaff          ClinicUser[]                    @relation("ServiceStaff")
  allowedSpaces          ClinicSpace[]                   @relation("SpaceAllowedServices")
  staffSchedules         ClinicStaffSchedule[]           @relation("ScheduleAllowedServices")
  staffServiceTimings    ClinicStaffServiceTiming[]
  ledgerEntries          AccountingLedgerEntry[]
  appointments           Appointment[]
}

model SubService {
  id         String @id @default(uuid())
  serviceId  String
  title      String
  price      Int
  attributes Json   @default("[]")

  // زمان‌بندی اختیاری در سطح زیرسرویس (در صورت null بودن از Service ارث می‌برد)
  timingMode        ServiceTimingMode?
  prepBeforeMinutes Int?
  durationMinutes   Int?
  stage1Minutes     Int?
  freeGapMinutes    Int?
  stage2Minutes     Int?
  restAfterMinutes  Int?
  requiresPrivacy   Boolean?

  service          Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providedServices ProvidedService[]
  defaultProducts  ServiceDefaultProduct[]
  exclusiveBatches ProductBatch[]
  careSmsTemplates CareSmsTemplate[]
  appointments     Appointment[]
}

// ==========================================
// 7. نوبت‌دهی و رزرواسیون (دستی و اتوماتیک)
// ==========================================
model Appointment {
  id           String  @id @default(uuid())
  clinicId     String
  clientId     String
  serviceId    String
  subServiceId String?
  therapistId  String? // پزشک یا اپراتور انجام‌دهنده
  spaceId      String? // اتاق / یونیت / بیمارستان رزرو‌شده
  createdById  String? // پرسنل ثبت‌کننده نوبت

  bookingSource AppointmentBookingSource @default(MANUAL)
  status        AppointmentStatus        @default(CONFIRMED)

  // تاریخ (UTC midnight روز تقویمی) و ساعات دقیق نوبت (HH:mm)
  date         DateTime
  arrivalTime  String   // ساعت حضور مراجع (شامل prepBeforeMinutes)
  startTime    String   // ساعت شروع واقعی سرویس
  endTime      String   // ساعت پایان کار سرویس (قبل از restAfterMinutes)
  blockEndTime String   // پایان کل اشغال (شامل restAfterMinutes)

  // اسنپ‌شات زمان‌بندی سرویس در لحظه رزرو (جهت محاسبه دقیق تداخل و تایم آزاد میانی مثل PRP)
  timingMode        ServiceTimingMode @default(SINGLE_STAGE)
  prepBeforeMinutes Int               @default(0)
  durationMinutes   Int               @default(30)
  stage1Minutes     Int               @default(15)
  freeGapMinutes    Int               @default(0)
  stage2Minutes     Int               @default(15)
  restAfterMinutes  Int               @default(0)
  requiresPrivacy   Boolean           @default(false)

  // در صورت رزرو دستی با تایید هشدار مدیریتی
  isManualOverride   Boolean @default(false)
  overrideReason     String? @db.Text
  notes              String? @db.Text
  cancellationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  subService SubService?  @relation(fields: [subServiceId], references: [id], onDelete: SetNull)
  therapist  ClinicUser?  @relation("AppointmentTherapist", fields: [therapistId], references: [id], onDelete: SetNull)
  space      ClinicSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  createdBy  ClinicUser?  @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, date])
  @@index([clinicId, therapistId, date])
  @@index([clinicId, spaceId, date])
  @@index([clinicId, clientId, date])
  @@index([clinicId, status])
}

// ==========================================
// 8. انبارداری داخلی کلینیک (ERP دو واحدی: بسته + جزء مصرفی)
// ==========================================
model ClinicProduct {
  id              String  @id @default(uuid())
  clinicId        String
  name            String
  code            String?
  unit            String
  packageUnit     String?
  unitsPerPackage Float   @default(1)
  alertThreshold  Float   @default(0)

  clinic                      Clinic                        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  batches                     ProductBatch[]
  usedInServices              UsedConsumable[]
  stockOuts                   InventoryStockOut[]
  defaultForServices          ServiceDefaultProduct[]
  defaultForServiceCategories ServiceCategoryDefaultProduct[]

  @@index([clinicId])
}

model ProductBatch {
  id              String    @id @default(uuid())
  clinicProductId String
  quantity        Float
  initialQuantity Float     @default(0)
  purchasePrice   Int
  sellingPrice    Int?
  expirationDate  DateTime?
  createdAt       DateTime  @default(now())

  exclusiveSubServiceId String?
  exclusiveTherapistId  String?

  clinicProduct       ClinicProduct @relation(fields: [clinicProductId], references: [id], onDelete: Cascade)
  exclusiveSubService SubService?   @relation(fields: [exclusiveSubServiceId], references: [id], onDelete: SetNull)
  exclusiveTherapist  ClinicUser?   @relation(fields: [exclusiveTherapistId], references: [id], onDelete: SetNull)

  @@index([clinicProductId, createdAt])
}

model InventoryStockOut {
  id              String   @id @default(uuid())
  clinicId        String
  clinicProductId String
  createdById     String?
  quantity        Float
  unitCost        Int
  sellingPrice    Int?
  reason          String?
  createdAt       DateTime @default(now())

  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicProduct ClinicProduct @relation(fields: [clinicProductId], references: [id], onDelete: Cascade)
  createdBy     ClinicUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
}

// کالاهای مصرفی پیش‌فرض در سطح خدمت اصلی (که به ازای کل خدمت یک‌بار کسر می‌شوند)
model ServiceCategoryDefaultProduct {
  id              String @id @default(uuid())
  serviceId       String
  clinicProductId String
  quantity        Float

  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clinicProduct ClinicProduct @relation(fields: [clinicProductId], references: [id], onDelete: Cascade)

  @@unique([serviceId, clinicProductId])
}

// کالاهای مصرفی پیش‌فرض در سطح زیرسرویس (که به ازای هر زیرسرویس کسر می‌شوند)
model ServiceDefaultProduct {
  id              String @id @default(uuid())
  subServiceId    String
  clinicProductId String
  quantity        Float

  subService    SubService    @relation(fields: [subServiceId], references: [id], onDelete: Cascade)
  clinicProduct ClinicProduct @relation(fields: [clinicProductId], references: [id], onDelete: Cascade)

  @@unique([subServiceId, clinicProductId])
}

// ==========================================
// 9. فاکتور، اقساط، خدمات ارائه‌شده و مصرفیات بیمار
// ==========================================
model Invoice {
  id            String @id @default(uuid())
  clinicId      String
  clientId      String
  invoiceNumber Int?

  subTotalAmount    Int     @default(0)
  discountAmount    Int     @default(0)
  discountReason    String? @db.Text
  extraChargeAmount Int     @default(0)
  extraChargeReason String? @db.Text
  taxAmount         Int     @default(0)
  creditFeeAmount   Int     @default(0)
  totalAmount       Int

  depositAmount       Int     @default(0)
  depositServiceTitle String?

  status     String
  paidAmount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinic           Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  providedServices ProvidedService[]
  payments         Payment[]
  installments     InvoiceInstallment[]

  @@index([clinicId, createdAt])
}

model InvoiceInstallment {
  id                String    @id @default(uuid())
  invoiceId         String
  installmentNumber Int
  amount            Int
  dueDate           DateTime
  isCheck           Boolean   @default(false)
  checkNumber       String?
  status            String    @default("PENDING")
  paidAt            DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ProvidedService {
  id                    String  @id @default(uuid())
  invoiceId             String?
  clientId              String
  subServiceId          String
  therapistId           String?
  therapistNameSnapshot String?
  referrerId            String?
  referrerClientId      String?
  createdById           String?
  tag                   String?

  performedAt     DateTime @default(now())
  finalPrice      Int
  description     String?  @db.Text
  therapistAmount Int      @default(0)
  assistantAmount Int      @default(0)
  referrerAmount  Int      @default(0)
  clinicNetProfit Int      @default(0)
  createdAt       DateTime @default(now())

  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subService      SubService       @relation(fields: [subServiceId], references: [id])
  therapist       ClinicUser?      @relation("ServiceTherapist", fields: [therapistId], references: [id], onDelete: SetNull)
  referrer        ClinicUser?      @relation("ServiceReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  referrerClient  Client?          @relation("ServiceClientReferrer", fields: [referrerClientId], references: [id], onDelete: SetNull)
  assistants      ClinicUser[]     @relation("ServiceAssistants")
  usedConsumables UsedConsumable[]
  attributes      Json             @default("[]")
}

model UsedConsumable {
  id                String  @id @default(uuid())
  providedServiceId String
  clinicProductId   String
  productBatchId    String?

  quantity     Float
  sellingPrice Int?
  unitCost     Int

  providedService ProvidedService @relation(fields: [providedServiceId], references: [id], onDelete: Cascade)
  clinicProduct   ClinicProduct   @relation(fields: [clinicProductId], references: [id])
}

// ==========================================
// 10. مالی، پرداخت‌ها و صندوق و حسابداری
// ==========================================
model ClinicBankAccount {
  id            String  @id @default(uuid())
  clinicId      String
  bankName      String
  accountNumber String
  cardNumber    String?
  iban          String?
  ownerName     String
  isActive      Boolean @default(true)

  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  terminals PaymentTerminal[]
}

model PaymentTerminal {
  id            String  @id @default(uuid())
  clinicId      String
  bankAccountId String
  name          String
  type          String  @default("POS")
  terminalCode  String?
  isActive      Boolean @default(true)

  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  bankAccount ClinicBankAccount @relation(fields: [bankAccountId], references: [id])
  payments    Payment[]
}

model ClinicCreditProvider {
  id                String   @id @default(uuid())
  clinicId          String
  title             String
  commissionPercent Float    @default(0)
  clientFeePercent  Float    @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([clinicId, isActive])
}

model Payment {
  id            String @id @default(uuid())
  invoiceId     String
  amount        Int
  paymentMethod String

  terminalId       String?
  creditProviderId String?
  creditProvider   String?
  creditPrincipal  Int      @default(0)
  creditClientFee  Int      @default(0)
  creditClinicCost Int      @default(0)
  trackingCode     String?
  status           String
  createdAt        DateTime @default(now())
  paidAt           DateTime @default(now())

  invoice              Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  terminal             PaymentTerminal?      @relation(fields: [terminalId], references: [id])
  creditProviderConfig ClinicCreditProvider? @relation(fields: [creditProviderId], references: [id], onDelete: SetNull)
}

model AccountingBeneficiary {
  id        String   @id @default(uuid())
  clinicId  String
  fullName  String
  phone     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  clinic        Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  ledgerEntries AccountingLedgerEntry[]

  @@index([clinicId])
}

model AccountingDescriptionItem {
  id        String   @id @default(uuid())
  clinicId  String
  scope     String   // PAYOUT | RECEIVE | DEBT
  title     String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, scope])
}

model AccountingLedgerEntry {
  id              String              @id @default(uuid())
  clinicId        String
  entryType       AccountingEntryType
  beneficiaryId   String?
  serviceId       String?
  therapistId     String?
  clientId        String?
  createdById     String?
  paymentMethod   String?
  descriptionText String?
  amount          Int
  notes           String?             @db.Text
  entryDate       DateTime            @default(now())
  createdAt       DateTime            @default(now())

  clinic        Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  beneficiary   AccountingBeneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  service       Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  therapist     ClinicUser?            @relation(fields: [therapistId], references: [id], onDelete: SetNull)
  client        Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clinicId, entryType, entryDate])
}

// ==========================================
// 11. سیستم اطلاع‌رسانی و پیامک
// ==========================================
model ClinicSmsSetting {
  id       String @id @default(uuid())
  clinicId String @unique

  appointmentBooked   Boolean @default(true)
  appointmentReminder Boolean @default(true)
  appointmentCanceled Boolean @default(true)
  appointmentEdited   Boolean @default(true)
  serviceRegistered   Boolean @default(true)
  paymentReceived     Boolean @default(true)
  surveySent          Boolean @default(false)
  birthdayGreeting    Boolean @default(false)
  fileRegistered      Boolean @default(true)
  discountCodeCreated Boolean @default(false)
  walletIncreased     Boolean @default(true)
  walletDecreased     Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model CareSmsTemplate {
  id           String  @id @default(uuid())
  clinicId     String
  serviceId    String?
  subServiceId String?

  title       String
  triggerType String
  offsetHours Int
  messageBody String  @db.Text
  isActive    Boolean @default(true)

  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  service    Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  subService SubService? @relation(fields: [subServiceId], references: [id], onDelete: SetNull)
}

model BulkSmsCampaign {
  id            String    @id @default(uuid())
  clinicId      String
  title         String
  messageBody   String    @db.Text
  scheduledFor  DateTime?
  targetFilters Json?

  status    String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model SmsLog {
  id       String  @id @default(uuid())
  clinicId String
  clientId String?

  mobileNumber String
  title        String?
  messageBody  String  @db.Text
  partsCount   Int     @default(1)

  type   String
  status String
  sentAt DateTime @default(now())

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}